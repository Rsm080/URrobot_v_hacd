  <!--################################################
  ########      milling spindle + end mill         #####
  ####################################################-->
  <!-- 末端执行器：转接法兰 -> 电主轴 -> 铣刀，三个关节全是 fixed。
       mesh 由 make_spindle_meshes.py 生成（尺寸也在那个文件顶部）：
       每个 link 的原点都落在"与上一节贴合的法兰面"上，网格沿 +z 生长。
       挂载姿态 rpy 和原来的 Robotiq 夹爪一样，所以主轴轴线 = 夹爪的进给方向
       （home 姿态下竖直向下）。 -->

  <joint name="spindle_mount_joint" type="fixed">
    <parent link="ee_link"/>
    <child link="spindle_mount_link"/>
    <origin rpy="-1.57 1.57 -1.57" xyz="0.0 0.0 0.0"/>
  </joint>

  <link name="spindle_mount_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/spindle/visual/spindle_mount.stl"/>
      </geometry>
      <material name="SpindleMountGray">
        <color rgba="0.45 0.47 0.50 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/spindle/collision/spindle_mount.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.007"/>
      <mass value="0.60"/>
      <inertia ixx="0.0003" ixy="0.0" ixz="0.0" iyy="0.0003" iyz="0.0" izz="0.00058"/>
    </inertial>
  </link>

  <joint name="spindle_body_joint" type="fixed">
    <parent link="spindle_mount_link"/>
    <child link="spindle_link"/>
    <origin rpy="0 0 0" xyz="0.0 0.0 0.014"/>
  </joint>

  <link name="spindle_link">
    <!-- 机身 / 前座 / 螺母各是一个凸 mesh：拆成三个 <collision>，
         凸分解时各成 1 个凸块（不必跑 V-HACD，也不会把螺母放大成 Ø80） -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/spindle/visual/spindle_body.stl"/>
      </geometry>
      <material name="SpindleBodyGray">
